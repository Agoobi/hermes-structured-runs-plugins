{
  "openapi": "3.1.0",
  "info": {
    "title": "Hermes Structured Runs API",
    "version": "1.3.0",
    "description": "Wrapper `structured-runs` trên port `:8646` (tag **structured-runs**) cộng với các endpoint của Hermes API server thật trên `:8642` mà wrapper bọc / người dùng cần gọi trực tiếp (tag **hermes-core**).\n\nMọi request dùng `Authorization: Bearer <API key>` giống hệt như gọi thẳng `:8642`.\n\nXem thêm `docs/ARCHITECTURE.md` cho luồng xử lý chi tiết."
  },
  "servers": [
    { "url": "http://localhost:8646", "description": "structured-runs wrapper (plugin)" },
    { "url": "http://localhost:8642", "description": "Hermes API server thật (upstream)" }
  ],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "structured-runs", "description": "Endpoint do plugin thêm, chạy trên :8646" },
    { "name": "hermes-core", "description": "Endpoint của Hermes API server (:8642) — không thuộc plugin, liệt kê để tiện tham chiếu" }
  ],
  "paths": {
    "/v1/runs/structured": {
      "post": {
        "tags": ["structured-runs"],
        "summary": "Tạo structured run",
        "description": "Tạo một run Hermes bình thường (`POST :8642/v1/runs`) và đính kèm `json_schema` để finalize output cuối. Các field khác trong body được forward nguyên vẹn lên upstream (`session_id`, `model`, `instructions`, `conversation_history`, `previous_response_id`, ...). Chỉ các header trong allowlist đi qua ranh giới.",
        "operationId": "createStructuredRun",
        "servers": [{ "url": "http://localhost:8646" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StructuredRunCreateRequest" },
              "example": {
                "input": "Dùng terminal chạy `date` và trả về kết quả.",
                "json_schema": {
                  "type": "object",
                  "properties": {
                    "used_tool": { "type": "boolean" },
                    "command": { "type": "string" },
                    "current_datetime": { "type": "string" },
                    "summary": { "type": "string" }
                  },
                  "required": ["used_tool", "command", "current_datetime", "summary"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run đã được tạo ở upstream. Trả nguyên object của `POST /v1/runs` cộng thêm các field `structured*`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StructuredRunCreateResponse" },
                "example": { "run_id": "run_abc123", "status": "started", "structured": true, "structured_status": "pending", "structured_schema_name": "run.finalizer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": {
            "description": "Upstream `/v1/runs` không trả `run_id`.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/v1/runs/structured/{run_id}": {
      "get": {
        "tags": ["structured-runs"],
        "summary": "Poll structured run",
        "description": "Poll trạng thái upstream. Khi upstream `completed`, wrapper chạy finalizer (settle → thử finalize output gốc → nếu cần thì post-completion agent check → `complete_structured`) và trả `parsed`.\n\nKhi upstream trả `404` (hết retention), wrapper phục hồi từ `upstream_snapshot` đã persist hoặc từ `state.db`. Khi upstream trả `401`/`403`, wrapper **không** trả kết quả cache.",
        "operationId": "pollStructuredRun",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": {
            "description": "Trạng thái merged.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StructuredRun" },
                "examples": {
                  "running": { "value": { "object": "hermes.run", "run_id": "run_abc123", "status": "running", "structured": true, "structured_status": "pending", "parsed": null } },
                  "completed": {
                    "value": {
                      "object": "hermes.run",
                      "run_id": "run_abc123",
                      "status": "completed",
                      "output": "Sat Aug 8 12:24:16 UTC 2026",
                      "structured": true,
                      "structured_status": "completed",
                      "parsed": { "used_tool": true, "command": "date", "current_datetime": "Sat Aug 8 12:24:16 UTC 2026", "summary": "Đã chạy date." },
                      "content_type": "json",
                      "structured_model": "gpt-5.5",
                      "structured_validation": "enforced",
                      "structured_error": null,
                      "final_output_check": { "status": "skipped", "reason": "first_pass_schema_valid" },
                      "session_settle": { "status": "settled" },
                      "verified_artifacts": []
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Không recover được run ở cả wrapper lẫn `state.db`.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/v1/runs/structured/{run_id}/events": {
      "get": {
        "tags": ["structured-runs"],
        "summary": "SSE stream cho structured run",
        "description": "SSE stream lấy từ **buffer per-run** mà wrapper duy trì (Hermes core không buffer/replay/broadcast event). Mỗi event có `id: <seq>`.\n\n**Replay khi reconnect:** gửi header `Last-Event-ID: <seq>` hoặc query `?after=<seq>` để chỉ nhận event mới hơn.\n\n`: keepalive` mỗi `STRUCTURED_RUNS_SSE_KEEPALIVE_S` giây rảnh. Khi run terminal, wrapper chạy finalizer (dù client không connect) và emit `structured.completed` / `structured.failed` / `structured.skipped`.\n\nEvent: `proxy.fallback`, `status`, `structured.*`, cộng event thô của upstream (`tool.started`, `tool.completed`, `message.delta`, `reasoning.available`, `run.completed`, ...).",
        "operationId": "streamStructuredRunEvents",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "name": "after", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Chỉ nhận event có `seq` lớn hơn giá trị này (thay cho `Last-Event-ID`)." },
          { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "integer" }, "description": "Resume từ seq này (chuẩn SSE)." }
        ],
        "responses": {
          "200": {
            "description": "`text/event-stream`.",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "id: 1\nevent: tool.started\ndata: {\"event\":\"tool.started\",\"tool\":\"terminal\"}\n\nid: 6\nevent: status\ndata: {\"run_id\":\"run_abc123\",\"status\":\"completed\",\"terminal\":true}\n\nid: 7\nevent: structured.completed\ndata: {\"run_id\":\"run_abc123\",\"structured_status\":\"completed\",\"parsed\":{\"used_tool\":true}}\n\n"
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/runs/structured/{run_id}/events/log": {
      "get": {
        "tags": ["structured-runs"],
        "summary": "Buffer event dạng JSON (fetch phẳng)",
        "description": "Trả toàn bộ buffer event của run dưới dạng JSON (không stream), cộng structured result hiện tại. Dùng khi bạn muốn **lấy lại log** sau này thay vì stream trực tiếp. `?after=<seq>` chỉ trả event mới hơn.\n\nBuffer giữ tối đa `STRUCTURED_RUNS_EVENT_LOG_MAX_EVENTS` event, tồn tại `STRUCTURED_RUNS_EVENT_LOG_TTL_S` giây sau khi run close, in-memory (mất khi gateway restart).",
        "operationId": "getStructuredRunEventLog",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "name": "after", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Chỉ trả event có `seq` lớn hơn giá trị này." }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventLog" },
                "example": {
                  "run_id": "run_abc123",
                  "closed": true,
                  "upstream_state": "closed",
                  "next_after": 7,
                  "events": [
                    { "seq": 1, "name": "tool.started", "ts": 1788487179.32, "data": { "tool": "terminal" } },
                    { "seq": 7, "name": "structured.completed", "ts": 1788487190.1, "data": { "structured_status": "completed", "parsed": { "used_tool": true } } }
                  ],
                  "structured": { "structured_status": "completed", "parsed": { "used_tool": true }, "structured_error": null, "structured_validation": "enforced", "final_output_check": { "status": "skipped", "reason": "first_pass_schema_valid" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Structured run không tồn tại.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/structured/{run_id}/media": {
      "get": {
        "tags": ["structured-runs"],
        "summary": "Serve artifact của structured run",
        "description": "Trả file media/artifact. 4 lớp kiểm tra: (1) caller phải qua auth upstream (`GET /v1/capabilities`); (2) `run_id` phải known; (3) `path` phải trùng một field `*_path` trong `parsed`; (4) file phải nằm dưới `STRUCTURED_RUNS_MEDIA_ROOTS` và không phải file nhạy cảm (`.db`/`.sqlite`, state file). `../` traversal, symlink escape, NUL byte bị chặn.\n\nLưu ý browser: `<video src>` không gắn được header `Authorization` — dùng `fetch()` + `Blob`.",
        "operationId": "serveStructuredRunMedia",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Giá trị `*_path` lấy nguyên từ `parsed` (thường là absolute path đã canonicalize).",
            "example": "/root/.hermes/media/run_abc123/out.mp4"
          }
        ],
        "responses": {
          "200": {
            "description": "Nội dung file.",
            "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "`path` không được đính kèm run này.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Run không tồn tại, hoặc file không tìm thấy / không được phép.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/v1/runs/structured/{run_id}/stop": {
      "post": {
        "tags": ["structured-runs"],
        "summary": "Dừng structured run",
        "description": "Passthrough tới `POST :8642/v1/runs/{run_id}/stop`. Nếu thành công và structured chưa xong, đánh dấu `structured_status = \"skipped\"` (`error: \"upstream_stopping\"`).",
        "operationId": "stopStructuredRun",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } }
        },
        "responses": {
          "200": { "description": "Body của upstream, nguyên trạng.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/runs/structured/{run_id}/approval": {
      "post": {
        "tags": ["structured-runs"],
        "summary": "Trả lời approval của structured run",
        "description": "Passthrough tới `POST :8642/v1/runs/{run_id}/approval`.",
        "operationId": "approveStructuredRun",
        "servers": [{ "url": "http://localhost:8646" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalRequest" } } }
        },
        "responses": {
          "200": { "description": "Body của upstream, nguyên trạng.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["structured-runs"],
        "summary": "Health của plugin",
        "description": "Không cần auth. Của **plugin** (:8646). Hermes core (:8642) cũng có `/health` nhưng shape khác.",
        "operationId": "pluginHealth",
        "security": [],
        "servers": [{ "url": "http://localhost:8646" }],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok", "plugin": "structured-runs", "upstream": "http://127.0.0.1:8642", "tracked_runs": 12, "running_finalizers": 1, "state_file": "/root/.hermes/structured_runs_state.json", "jsonschema_validation": true }
              }
            }
          }
        }
      }
    },

    "/v1/runs": {
      "post": {
        "tags": ["hermes-core"],
        "summary": "Tạo agent run (upstream)",
        "description": "Endpoint gốc của Hermes. `POST /v1/runs/structured` bọc chính endpoint này. Trả `run_id` ngay lập tức (`202`), agent chạy nền.",
        "operationId": "createHermesRun",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/SessionKeyHeader" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HermesRunCreateRequest" } } }
        },
        "responses": {
          "202": {
            "description": "Run đã khởi tạo.",
            "headers": { "X-Hermes-Session-Key": { "schema": { "type": "string" }, "description": "Echo lại nếu request có gửi." } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HermesRunAccepted" }, "example": { "run_id": "run_abc123", "status": "started" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "description": "Vượt `max_concurrent_runs`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "tags": ["hermes-core"],
        "summary": "Trạng thái run (upstream)",
        "description": "Registry in-memory, có thể trả `404` sau khi hết retention.",
        "operationId": "getHermesRun",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HermesRunStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "`run_not_found`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/{run_id}/events": {
      "get": {
        "tags": ["hermes-core"],
        "summary": "SSE lifecycle events (upstream)",
        "description": "Live stream từ một `asyncio.Queue` per-run. **Không buffer / không replay / không `Last-Event-ID`.** Trả `404` nếu run chưa đăng ký hoặc đã kết thúc (queue bị xoá khi stream đóng).",
        "operationId": "streamHermesRunEvents",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "description": "`text/event-stream`.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "`run_not_found`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/{run_id}/stop": {
      "post": {
        "tags": ["hermes-core"],
        "summary": "Dừng run (upstream)",
        "operationId": "stopHermesRun",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "`run_not_found`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/{run_id}/steer": {
      "post": {
        "tags": ["hermes-core"],
        "summary": "Chèn hướng dẫn vào agent đang chạy (upstream)",
        "description": "Không được plugin bọc. Gọi thẳng `:8642`.",
        "operationId": "steerHermesRun",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "input": { "type": "string" } }, "required": ["input"] } } }
        },
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "`run_not_found`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/runs/{run_id}/approval": {
      "post": {
        "tags": ["hermes-core"],
        "summary": "Trả lời approval (upstream)",
        "operationId": "approveHermesRun",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalRequest" } } } },
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "description": "Không có approval đang chờ.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": ["hermes-core"],
        "summary": "Khả năng của API server (upstream)",
        "description": "Wrapper dùng chính endpoint này để kiểm tra auth trước khi serve media.",
        "operationId": "getHermesCapabilities",
        "servers": [{ "url": "http://localhost:8642" }],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true }, "example": { "object": "hermes.api_server.capabilities", "endpoints": { "run_create": { "method": "POST", "path": "/v1/runs" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "get": {
        "tags": ["hermes-core"],
        "summary": "Lịch sử message của session (upstream)",
        "description": "Của Hermes core (không phải plugin). Với structured run, `session_id` = `run_id`. Trả message hội thoại (assistant/tool) — **không** phải SSE lifecycle event.",
        "operationId": "getSessionMessages",
        "servers": [{ "url": "http://localhost:8642" }],
        "parameters": [
          { "name": "session_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 500 }, "description": "Bỏ trống = 1 trang mặc định (tối đa 500)." },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "order", "in": "query", "required": false, "schema": { "type": "string", "enum": ["oldest", "latest"] } }
        ],
        "responses": {
          "200": { "description": "OK.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Session không tồn tại.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "API server key — cùng key như gọi thẳng :8642." }
    },
    "parameters": {
      "RunId": { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "run_abc123" },
      "SessionKeyHeader": { "name": "X-Hermes-Session-Key", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Scope bộ nhớ dài hạn (tùy chọn)." }
    },
    "responses": {
      "InvalidRequest": { "description": "Request không hợp lệ.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Thiếu / sai API key. Wrapper **không** trả kết quả cache khi upstream trả 401/403.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        },
        "additionalProperties": true
      },
      "StructuredRunCreateRequest": {
        "type": "object",
        "required": ["input", "json_schema"],
        "properties": {
          "input": {
            "description": "Prompt của user — string, hoặc mảng message `{role, content}` (message cuối là user message).",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "object", "properties": { "role": { "type": "string" }, "content": {} }, "required": ["role", "content"] } }
            ]
          },
          "json_schema": {
            "type": "object",
            "description": "JSON Schema (Draft 2020-12) cho output cuối. `type` phải là `\"object\"`. Nên dùng `additionalProperties: false`.",
            "additionalProperties": true
          },
          "schema": { "type": "object", "description": "Alias của `json_schema`.", "additionalProperties": true },
          "schema_name": { "type": "string", "default": "run.finalizer" },
          "session_id": { "type": "string", "description": "Forward tới upstream. Bỏ trống = upstream dùng `run_id`." },
          "model": { "type": "string" },
          "instructions": { "type": "string" },
          "conversation_history": { "type": "array", "items": { "type": "object", "properties": { "role": { "type": "string" }, "content": { "type": "string" } }, "required": ["role", "content"] } },
          "previous_response_id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "StructuredRunCreateResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/HermesRunAccepted" },
          {
            "type": "object",
            "properties": {
              "structured": { "type": "boolean", "const": true },
              "structured_status": { "type": "string", "const": "pending" },
              "structured_schema_name": { "type": "string" }
            }
          }
        ]
      },
      "StructuredUsage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer" },
          "output_tokens": { "type": "integer" },
          "total_tokens": { "type": "integer" }
        }
      },
      "FinalOutputCheck": {
        "type": "object",
        "description": "Kết quả bước post-completion + toàn bộ lịch sử attempt. Attempt 0 = finalize output gốc của agent (không agent turn); attempt 1..N = re-check agent turn, tối đa `STRUCTURED_RUNS_FINAL_CHECK_MAX_ATTEMPTS` (clamp [0,7]).",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["skipped", "completed", "exhausted", "fallback"],
            "description": "`skipped` = attempt 0 đạt schema hoặc `mode=off`; `completed` = một re-check ra JSON hợp lệ; `exhausted` = hết MAX_ATTEMPTS vẫn lệch (`structured_status=failed`); `fallback` = dừng sớm vì agent turn liên tục không chạy được."
          },
          "reason": { "type": ["string", "null"], "enum": ["first_pass_schema_valid", "final_check_disabled", null] },
          "recheck_attempts": { "type": "integer", "description": "Số re-check agent turn đã chạy." },
          "resolved_on_attempt": { "type": ["integer", "null"], "description": "Attempt (0..N) tạo ra JSON hợp lệ được commit; null nếu không attempt nào đạt." },
          "last_recheck_run_id": { "type": ["string", "null"] },
          "run_id": { "type": ["string", "null"], "description": "Alias của `last_recheck_run_id` (giữ cho client cũ)." },
          "history": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FinalOutputCheckAttempt" }
          }
        }
      },
      "FinalOutputCheckAttempt": {
        "type": "object",
        "properties": {
          "attempt": { "type": "integer" },
          "kind": { "type": "string", "enum": ["agent_output", "agent_recheck"] },
          "recheck_run_id": { "type": ["string", "null"] },
          "recheck_status": { "type": ["string", "null"], "enum": ["completed", "fallback", null] },
          "recheck_error": { "type": ["string", "null"] },
          "outcome": { "type": "string", "enum": ["valid", "invalid", "finalizer_error"] },
          "validation_error": { "type": ["string", "null"] },
          "finalizer_text_preview": { "type": ["string", "null"], "description": "Chars đầu của text finalizer tạo ra (độ dài = `STRUCTURED_RUNS_FINAL_CHECK_TEXT_PREVIEW_CHARS`)." }
        }
      },
      "SessionSettle": {
        "type": "object",
        "description": "Kết quả chờ delegation của session settle.",
        "properties": {
          "status": { "type": "string", "enum": ["settled", "timeout", "unavailable"] },
          "pending_delegations": { "type": "integer" },
          "pending_delivery": { "type": "integer" },
          "last_activity_at": { "type": ["number", "null"] }
        }
      },
      "StructuredRun": {
        "type": "object",
        "description": "Object merged do `merge_structured` dựng: object của upstream `/v1/runs` cộng các field `structured*`.",
        "properties": {
          "object": { "type": "string", "example": "hermes.run" },
          "run_id": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed", "cancelled", "unknown"], "description": "Trạng thái upstream." },
          "output": { "type": "string", "description": "Raw output cuối của agent (đã qua settle + check)." },
          "usage": { "$ref": "#/components/schemas/StructuredUsage" },
          "structured": { "type": "boolean" },
          "structured_status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "skipped"], "description": "Trạng thái của lớp structured. `skipped` = upstream failed/cancelled/stopped." },
          "parsed": { "type": ["object", "null"], "description": "JSON đúng `json_schema`, hoặc `null` khi chưa xong / finalize thất bại.", "additionalProperties": true },
          "content_type": { "type": ["string", "null"] },
          "structured_model": { "type": ["string", "null"] },
          "structured_usage": { "oneOf": [{ "$ref": "#/components/schemas/StructuredUsage" }, { "type": "null" }] },
          "structured_error": { "type": ["string", "null"] },
          "structured_schema_name": { "type": ["string", "null"] },
          "structured_validation": { "type": ["string", "null"], "enum": ["enforced", "skipped_no_jsonschema", null], "description": "`skipped_no_jsonschema` = package `jsonschema` không cài, contract không được enforce." },
          "final_output_check": { "oneOf": [{ "$ref": "#/components/schemas/FinalOutputCheck" }, { "type": "null" }] },
          "session_settle": { "oneOf": [{ "$ref": "#/components/schemas/SessionSettle" }, { "type": "null" }] },
          "verified_artifacts": { "type": "array", "items": { "type": "string" }, "description": "Absolute path đã xác minh tồn tại dưới `STRUCTURED_RUNS_MEDIA_ROOTS`." },
          "upstream_status_unavailable": { "type": "boolean", "description": "Có khi phải phục hồi từ snapshot / state.db." },
          "session_recovered": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "plugin": { "type": "string", "example": "structured-runs" },
          "upstream": { "type": "string" },
          "tracked_runs": { "type": "integer" },
          "running_finalizers": { "type": "integer" },
          "state_file": { "type": "string" },
          "jsonschema_validation": { "type": "boolean" }
        }
      },
      "ApprovalRequest": {
        "type": "object",
        "required": ["choice"],
        "properties": {
          "choice": { "type": "string", "enum": ["once", "session", "always", "deny", "approve", "allow"], "description": "`approve`/`allow` là alias của `once`." },
          "all": { "type": "boolean", "description": "Giải quyết mọi approval đang chờ của run." }
        }
      },
      "HermesRunCreateRequest": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "object" } }
            ]
          },
          "instructions": { "type": "string" },
          "session_id": { "type": "string" },
          "model": { "type": "string" },
          "conversation_history": { "type": "array", "items": { "type": "object", "properties": { "role": { "type": "string" }, "content": { "type": "string" } }, "required": ["role", "content"] } },
          "previous_response_id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "HermesRunAccepted": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "status": { "type": "string", "example": "started" }
        }
      },
      "HermesRunStatus": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "example": "hermes.run" },
          "run_id": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed", "cancelled"] },
          "created_at": { "type": "number" },
          "updated_at": { "type": "number" },
          "session_id": { "type": "string" },
          "model": { "type": "string" },
          "last_event": { "type": "string", "description": "Tên event SSE cuối cùng — CHỈ event cuối, không phải cả log." },
          "output": { "type": "string" },
          "usage": { "$ref": "#/components/schemas/StructuredUsage" }
        },
        "additionalProperties": true
      },
      "BufferedEvent": {
        "type": "object",
        "properties": {
          "seq": { "type": "integer", "description": "Số thứ tự tăng dần trong run; dùng cho `?after=` / `Last-Event-ID`." },
          "name": { "type": "string", "description": "Tên event (vd `tool.started`, `message.delta`, `status`, `structured.completed`)." },
          "ts": { "type": "number", "description": "Unix time lúc wrapper buffer event." },
          "data": { "type": "object", "additionalProperties": true }
        }
      },
      "EventLog": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "closed": { "type": "boolean", "description": "Drainer đã đóng (run terminal)." },
          "upstream_state": { "type": "string", "enum": ["pending", "streaming", "poll_fallback", "closed"] },
          "next_after": { "type": "integer", "description": "`seq` của event cuối — truyền lại làm `?after=` cho lần fetch sau." },
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/BufferedEvent" } },
          "structured": {
            "type": "object",
            "properties": {
              "structured_status": { "type": ["string", "null"] },
              "parsed": { "type": ["object", "null"], "additionalProperties": true },
              "structured_error": { "type": ["string", "null"] },
              "structured_validation": { "type": ["string", "null"] },
              "final_output_check": { "oneOf": [{ "$ref": "#/components/schemas/FinalOutputCheck" }, { "type": "null" }] }
            }
          }
        }
      }
    }
  }
}
